{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdtx",
  "version": "0.1.0",
  "identifier": "com.mdtx.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mdtx 翻译工作台",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/mdtx-api"]
  }
}
